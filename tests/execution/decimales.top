// Decimales en ensamblador: se guardan como enteros en centavos
presupuesto "Decimales" {
  decimal a = 12.34;
  decimal b = 0.66;
  decimal c = -5.5;
  entero n = 3;
  mostrar(a + b);
  mostrar(a - b);
  mostrar(b - a);
  mostrar(a * b);
  mostrar(a * c);
  mostrar(a / b);
  mostrar(c / 4);
  mostrar(1 / 3);
  mostrar(2 / 3);
  mostrar(a * n);
  mostrar(n + 0.5);
  mostrar(-a);
  mostrar(0.0);
  mostrar(a > b);
  mostrar(a == 12.34);
  mostrar(b <= 0.66);
  constante decimal IVA = 0.16;
  decimal ingreso = 5000.0;
  mostrar(ingreso * IVA);
  mostrar(ingreso - ingreso * IVA);
  mostrar("a=" + a + " n=" + n + " ok=" + (a > b));
  texto s = "x" + 1.5;
  texto t = s;
  s = s + "y";
  mostrar(t);
  mostrar(s);
  mostrar(s == "x1.50y");
  mostrar(t != "x1.50");
  categoria comida limite ingreso * 0.20 {
    gasto 450.50 descripcion "Super";
    gasto 120 descripcion "Cena";
  }
  mostrar(comida.limite);
  mostrar(comida.gastado);
  mostrar(comida.nombre);
  si (comida.gastado < comida.limite) { mostrar("dentro"); } sino { alerta("excedido"); }
  decimal x = 0.0;
  entero k = 0;
  mientras (k < 5) {
    x = x + 19.99;
    k = k + 1;
  }
  mostrar(x);
  mostrar(x * 0.07);
}
